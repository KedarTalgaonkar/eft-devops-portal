# Copy to .env (git-ignored). Every value has a safe default, so .env is optional.

# --- Database ---
POSTGRES_DB=eftportal
POSTGRES_USER=eft
POSTGRES_PASSWORD=eft

# --- Backend ---
# dev      = also loads sample inventory with fake hosts (leave out for a clean database)
# sso-dev  = single sign-on against the local Keycloak container (development)
# sso-entra = single sign-on with Microsoft Entra ID (production)
SPRING_PROFILES_ACTIVE=dev,sso-dev

# --- Sign-in ---
# Microsoft Entra ID app registration (profile sso-entra). Redirect URI: https://<portal-host>/login/oauth2/code/sso
ENTRA_TENANT_ID=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
PORTAL_SSO_LABEL='Sign in with Microsoft'
# Local (database) accounts: keep for break-glass; set false to allow SSO only
PORTAL_LOCAL_LOGIN=true
# First local administrator, created once when no local account exists; must be changed at first sign-in.
# At least 12 characters with three of: lower case, upper case, digit, symbol.
PORTAL_BOOTSTRAP_ADMIN_USERNAME=admin
PORTAL_BOOTSTRAP_ADMIN_PASSWORD=
# Role for SSO users without a mapped app role (VIEWER, EDITOR, ADMIN; empty = refuse them)
PORTAL_DEFAULT_ROLE=VIEWER

# --- Sessions ---
# true whenever the portal is served over HTTPS (always outside localhost)
PORTAL_COOKIE_SECURE=false
PORTAL_SESSION_IDLE_TIMEOUT=30m
PORTAL_SESSION_MAX_AGE=10h
# Swagger UI / OpenAPI (administrators only); false switches it off completely
PORTAL_API_DOCS=true
# Interface the portal listens on: 127.0.0.1 (this machine only) or 0.0.0.0 (network)
PORTAL_BIND_ADDRESS=127.0.0.1

# --- Local identity provider (development only) ---
KEYCLOAK_ADMIN=kcadmin
KEYCLOAK_ADMIN_PASSWORD=change-me-local-only

# --- Integrations: mock | live ---
JENKINS_MODE=mock
JENKINS_URL=
JENKINS_USER=
JENKINS_TOKEN=
# Jenkins job used when a deployment has none set. Placeholders: {app} {client} {ENV} {env}
JENKINS_JOB_PATTERN={app}-{ENV}

GITHUB_MODE=mock
GITHUB_URL=https://github.oneeuronet.com/api/v3
GITHUB_TOKEN=

SONAR_MODE=mock
SONAR_URL=https://sonarqube.oneeuronet.com
SONAR_TOKEN=

ARTIFACTORY_MODE=mock
ARTIFACTORY_URL=https://artifactory-kc.oneeuronet.com/artifactory
ARTIFACTORY_TOKEN=

MONITORING_MODE=mock
GRAFANA_URL=
GRAFANA_TOKEN=
PROMETHEUS_URL=

SBOM_MODE=mock

# Service health probes against inventory URLs: mock | live
HEALTH_PROBE_MODE=mock

# --- AI features (docs/ai.md) ---
# off | mock (sample answers, nothing leaves the portal) | live (Claude)
AI_MODE=mock
# anthropic | bedrock | foundry
AI_PROVIDER=anthropic
AI_MODEL=claude-opus-5-5
# anthropic
ANTHROPIC_API_KEY=
# bedrock: region plus a Bedrock API key (or AWS credentials / an IAM role)
AWS_REGION=
AWS_BEARER_TOKEN_BEDROCK=
# foundry
ANTHROPIC_FOUNDRY_API_KEY=
ANTHROPIC_FOUNDRY_RESOURCE=
# Limits: estimated USD per calendar month, requests per user per day
AI_MONTHLY_BUDGET_USD=100
AI_USER_DAILY_LIMIT=50
# How much of a failed build's log (its end) is analysed
AI_MAX_LOG_KB=64
# Host names ending in these are masked before sending (add your company domains); inventory hosts always are
AI_MASK_DOMAINS=.internal,.local,.corp,.lan
# Executive digest schedule (Spring cron: second minute hour day month weekday)
AI_DIGEST_ENABLED=true
AI_DIGEST_CRON='0 0 7 * * MON-FRI'
AI_DIGEST_ZONE=Asia/Kolkata

# --- Build-time mirrors (optional, for networks that block Maven Central / npmjs) ---
MAVEN_MIRROR_URL=
NPM_REGISTRY=
