# Copy to .env next to compose.yml (install.sh does this once). Keep .env private.

# Image tag inside this bundle (install.sh fills it in)
PORTAL_VERSION=

# --- Network ---
# 0.0.0.0 = reachable from the network, 127.0.0.1 = this server only
PORTAL_BIND_ADDRESS=0.0.0.0
PORTAL_PORT=8081
# true when users reach the portal over HTTPS (TLS terminated by your load balancer / reverse proxy)
PORTAL_COOKIE_SECURE=false

# --- Database (required) ---
POSTGRES_DB=eftportal
POSTGRES_USER=eft
# Set a strong password before the first start; changing it later needs a database change too
POSTGRES_PASSWORD=

# --- Sign-in ---
# Leave empty: local accounts only (no identity provider needed).
# sso-entra: Microsoft Entra ID, only if the servers and browsers can reach login.microsoftonline.com.
SPRING_PROFILES_ACTIVE=
# First local administrator, created once on an empty database; must be changed at first sign-in.
# At least 12 characters with three of: lower case, upper case, digit, symbol. Clear it after first sign-in.
PORTAL_BOOTSTRAP_ADMIN_USERNAME=admin
PORTAL_BOOTSTRAP_ADMIN_PASSWORD=
PORTAL_LOCAL_LOGIN=true
PORTAL_DEFAULT_ROLE=VIEWER
ENTRA_TENANT_ID=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
PORTAL_SSO_LABEL=
PORTAL_SESSION_IDLE_TIMEOUT=30m
PORTAL_SESSION_MAX_AGE=10h
PORTAL_API_DOCS=false

# --- Integrations: mock (sample data) | live (needs the internal tool to be reachable) ---
JENKINS_MODE=mock
JENKINS_URL=
JENKINS_USER=
JENKINS_TOKEN=
JENKINS_JOB_PATTERN={app}-{ENV}
GITHUB_MODE=mock
GITHUB_URL=
GITHUB_TOKEN=
SONAR_MODE=mock
SONAR_URL=
SONAR_TOKEN=
ARTIFACTORY_MODE=mock
ARTIFACTORY_URL=
ARTIFACTORY_TOKEN=
MONITORING_MODE=mock
GRAFANA_URL=
GRAFANA_TOKEN=
PROMETHEUS_URL=
SBOM_MODE=mock
HEALTH_PROBE_MODE=mock

# --- AI: off by default (no internet). The rest of the portal works without it. ---
AI_MODE=off
AI_DIGEST_ENABLED=false

TZ=Asia/Kolkata
